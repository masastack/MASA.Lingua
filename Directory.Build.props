<Project>
  <PropertyGroup>
    <!--
      TFM 一律在各 csproj 显式声明，本文件不设默认值（避免「项目忘写 TFM 时被静默兜底成单目标」）：
      单目标项目写 <TargetFramework>net10.0</TargetFramework>，
      多目标项目写 <TargetFrameworks>net8.0;net10.0</TargetFrameworks>（两个属性互斥）。
      现状：Server / Storage.* / AI / Tests 为 net10 闭包；Core 与 SDK.* 双目标供 .NET 8 业务端引用。
    -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    打包元数据：只作用于 Core 与 SDK.*（Server / Storage / AI / Tests 不产出 NuGet 包）。
    版本号只在此处维护，6 个包（Core + 5 个 SDK.*）共用同一版本；
    发版时改这一处，然后 dotnet pack -c Release 即可，无需命令行传 -p:Version。
    PackageId 未显式声明，默认取程序集名（MASA.Lingua.Core / MASA.Lingua.SDK.*），与包名约定一致。
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MASA.Lingua.Core' Or $(MSBuildProjectName.StartsWith('MASA.Lingua.SDK.'))">
    <Version>1.3.0</Version>
    <Authors>MASA</Authors>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/masastack/MASA.Lingua</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/masastack/MASA.Lingua/releases</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Release 配置下随构建直接产出 nupkg/snupkg，Debug 构建不打包 -->
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>
