@page "/"
@inherits MASA.Lingua.Server.Components.Pages.LinguaPageBase
@inject ILinguaRepository Repository
@inject MASA.Lingua.Server.Services.EntryAiTranslator AiTranslator
@inject DeterministicTranslationValidator Validator
@inject StaticBundlePublisher Publisher
@inject WorkspaceScope Scope
@inject ToastService Toasts
@inject Microsoft.Extensions.Logging.ILogger<Home> Logger
@inject IJSRuntime JS

<PageTitle>词条矩阵 · MASA.Lingua</PageTitle>

@{
    var rows = FilteredEntries;
    // 分页只影响矩阵展示：词条总数统计、检查报告、AI 批量补全仍作用于整个筛选范围
    var totalPages = Math.Max(1, (int)Math.Ceiling(rows.Count / (double)_pageSize));
    var pageIndex = Math.Min(_pageIndex, totalPages - 1);
    var pageRows = rows.Skip(pageIndex * _pageSize).Take(_pageSize).ToList();

    // 检查报告分页：与矩阵共用每页条数，页序号独立
    var reportTotalPages = Math.Max(1, (int)Math.Ceiling(_validationIssues.Count / (double)_pageSize));
    var reportPageIndex = Math.Min(_reportPageIndex, reportTotalPages - 1);
    var reportRows = _validationIssues.Skip(reportPageIndex * _pageSize).Take(_pageSize).ToList();
}

<div class="d-flex align-start justify-space-between flex-wrap mb-6" style="gap:1rem">
    <div style="min-width:0">
        <h1 class="text-h5 mb-1">词条矩阵</h1>
        <p class="text-body-2 mb-0">@Lede</p>
    </div>
    <div class="d-flex align-center flex-wrap" style="gap:0.5rem">
        @* 应用尚无多语言配置（非共享命名空间且没有项目数据）：这五个操作按钮都没有意义
           （检查/补全/发布/语种/密钥都需要已存在的词条或项目配置），只显示顶栏下方的「创建多语言配置」横幅。 *@
        @if (IsSharedScope || CurrentProject is not null)
        {
            @if (!IsSharedScope && _blockingCount > 0)
            {
                <MChip Small Color="Error"
                       title="Error 级规则（占位符 / 长度 / HTML）与术语库违规；已进入发布的这类译文会被发布门禁拦截（按项目发布策略）">
                    阻断问题 @_blockingCount
                </MChip>
            }
            <MButton OnClick="OnRunCheckClickedAsync" title="按规则与术语库重新检查当前范围内的全部译文">运行检查</MButton>
            <MButton OnClick="RunAiBatchTranslateAsync" Disabled="@_isBusy"
                     title="只处理缺失、草稿与待复核的译文；已审核与 AI 已通过的译文不会被覆盖">
                @(_isBusy ? "AI 处理中…" : "AI 批量补全")
            </MButton>
        }
        @if (!IsSharedScope && CurrentProject is not null)
        {
            @* 项目级配置不常用，但改的是「这个页面怎么工作」的前提：放在页头，和页面标题同一层级。 *@
            <MButton aria-haspopup="dialog" title="维护项目支持的语种与默认语种（改完立即生效）" OnClick="OpenCultureDrawer">语种设置</MButton>
            <MButton aria-haspopup="dialog" title="查看 / 重置缺词上报的项目写密钥（X-Lingua-Key）" OnClick="OpenWriteKeyDrawer">接入密钥</MButton>
            @* 发布固定排在最后：它是这一组里唯一的写线上动作（实心主按钮）。 *@
            <MButton Color="Primary" OnClick="PublishCurrentProjectAsync" Disabled="@_isBusy"
                     title="生成 App_Data/i18n/{项目}/{语种}.json（只经 /i18n 分发端点对外，不直出静态目录），并通过 SSE 通知业务端重新同步">
                发布
            </MButton>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <MAlert Type="@(_statusIsError ? AlertTypes.Error : AlertTypes.Success)"
            Dense Dismissible Value="true" ValueChanged="@(() => _statusMessage = null)" Class="mb-4" Role="status">
        @_statusMessage
    </MAlert>
}

@if (_isLoading)
{
    <div class="d-flex align-center justify-center py-16" style="gap:12px" Role="status">
        <MProgressCircular Indeterminate Size="22" Width="2" />
        <span class="text-body-2">正在加载当前项目的词条数据…</span>
    </div>
}
else
{
    <section aria-labelledby="coverage-title" class="mb-6">
        <MCard>
            <MCardText>
                <div class="d-flex align-center justify-space-between flex-wrap mb-4">
                    <h2 id="coverage-title" class="text-h6 mb-0">语种完成度</h2>
                    @if (_entryCount > 0)
                    {
                        <div class="d-flex flex-wrap align-center" aria-label="图例">
                            @foreach (var item in LegendItems)
                            {
                                <span class="d-flex align-center mr-4 text-body-2">
                                    <MSheet Width="10" Height="10" Color="@LegendColor(item.Css)" Class="mr-1" Rounded="true"></MSheet>
                                    @item.Label <b class="ml-1">@item.Count</b>
                                </span>
                            }
                        </div>
                    }
                </div>

                @if (_entryCount == 0)
                {
                    <MAlert Type="@AlertTypes.Info" Text Dense Class="mb-0">@ScopeName 下还没有词条。</MAlert>
                }
                else
                {
                    <div class="d-flex flex-column">
                        @for (var i = 0; i < _coverage.Count; i++)
                        {
                            var c = _coverage[i];
                            if (i > 0)
                            {
                                <MDivider />
                            }
                            <div class="d-flex align-center flex-wrap py-3" style="gap:1rem">
                                <div class="d-flex align-center flex-wrap" style="width:220px;min-width:200px;gap:0.25rem">
                                    <strong lang="@c.Culture">@UiText.Locale(c.Culture)</strong>
                                    <code>@c.Culture</code>
                                    @if (IsSourceCulture(c.Culture))
                                    {
                                        <span class="text-caption">源语言</span>
                                    }
                                    @if (GlossaryOf(c.Culture) is { Percent: { } pct } g)
                                    {
                                        <MChip XSmall Color="@(pct >= 100 ? "Success" : pct >= 80 ? "Warning" : "Error")"
                                               title="@($"术语遵循率：{g.Followed} / {g.Checked}（源文案命中的术语中，译文遵循标准译法或可接受变体且未使用禁用译法的比例）")">
                                            术语 @(pct)%
                                        </MChip>
                                    }
                                </div>
                                @* 五段堆叠条：各段宽度由数据驱动（flex 比例），颜色全部来自皮肤 token（Success/Info/Warning/Grey） *@
                                <div class="d-flex flex-grow-1" style="height:10px;border-radius:3px;overflow:hidden" Role="img" aria-label="@CoverageSummary(c)">
                                    @if (c.Approved > 0) { <MSheet Color="Success" Style="@Flex(c.Approved)" title="@($"已审核 {c.Approved}")"></MSheet> }
                                    @if (c.Ai > 0) { <MSheet Color="Info" Style="@Flex(c.Ai)" title="@($"AI 已译 {c.Ai}")"></MSheet> }
                                    @if (c.Review > 0) { <MSheet Color="Warning" Style="@Flex(c.Review)" title="@($"待复核 {c.Review}")"></MSheet> }
                                    @if (c.Missing > 0) { <MSheet Color="Grey" Style="@Flex(c.Missing)" title="@($"缺失 {c.Missing}")"></MSheet> }
                                </div>
                                <div class="text-right text-body-2" style="width:72px">@(c.Approved + c.Ai) <span class="text-caption">/ @c.Total</span></div>
                                @if (!IsSharedScope)
                                {
                                    <MButton Small Variant="Text" Href="@($"/i18n/{SelectedProjectCode}/{c.Culture}.json")" target="_blank" rel="noopener">
                                        <code>@(c.Culture).json</code>
                                    </MButton>
                                }
                            </div>
                        }
                    </div>
                }

                <MDivider Class="mt-4 mb-3" />
                @if (IsSharedScope)
                {
                    <span class="text-caption">共享命名空间随各项目一起发布，不单独生成文件。</span>
                }
                else if (CurrentProject is { } proj)
                {
                    <div class="d-flex flex-wrap align-center" style="gap:0.5rem 1.25rem">
                        <span class="text-caption">最近发布 <strong><LocalTime Value="@proj.LastPublishedAt" EmptyText="尚未发布" /></strong></span>
                        @if (!string.IsNullOrEmpty(proj.LastPublishedVersionHash))
                        {
                            @* 指纹是核对线上产物与草稿是否一致时唯一能逐字符比对的凭据：不截断，整串可选中、可复制 *@
                            <span class="text-caption d-flex align-center">
                                版本指纹
                                <code title="@proj.LastPublishedVersionHash">@proj.LastPublishedVersionHash</code>
                                <MButton XSmall Variant="Text" title="复制完整版本指纹" OnClick="CopyVersionHashAsync">复制</MButton>
                            </span>
                        }
                        <span class="text-caption">@_entryCount 条词条 · @ActiveCultures.Count 个语种</span>
                    </div>
                }
            </MCardText>
        </MCard>
    </section>

    <section aria-label="词条与检查">
        @* 页签 + 筛选行 + 表格 + 分页收在同一张卡片里：筛选行不再裸在页面背景上，
           与页签/表格之间的背景色断层也就消失了（原布局三层背景交替造成的割裂感）。 *@
        <MCard Class="mb-6">
            <MTabs Value="@ViewTabValue" ValueChanged="OnViewTabChanged" aria-label="词条视图">
                <MTab Value="@((int)MatrixView.Entries)">词条<MChip XSmall Class="ml-2">@rows.Count</MChip></MTab>
                <MTab Value="@((int)MatrixView.Report)">检查报告<MChip XSmall Class="ml-2">@_validationIssues.Count</MChip></MTab>
            </MTabs>
            <MDivider />

        @if (_view == MatrixView.Entries)
        {
            <div class="d-flex align-center flex-wrap pa-4" style="gap:0.5rem 1rem">
                <MSelect TItem="NsOption" TItemValue="string" TValue="string"
                         Items="NamespaceOptions"
                         ItemText="o => o.Label" ItemValue="o => o.Value"
                         @bind-Value="_selectedNamespaceCode" @bind-Value:after="OnNamespaceChanged"
                         Dense Outlined HideDetails="true" Style="max-width:200px" aria-label="命名空间" />
                @* 防抖在组件内完成：键击只重渲染输入框本身，停顿后才通知本页重新筛选（否则每个键击都整页重渲染两次） *@
                <SearchBox Value="@_searchKeyword" ValueChanged="OnSearchChanged"
                           AriaLabel="搜索 Key、文案、上下文"
                           Placeholder="搜索 Key、文案或上下文，如 {days}" />
                <MButtonGroup Dense aria-label="状态筛选">
                    <MButton Color="Primary" Outlined="@_onlyNeedsReview" OnClick="@(() => SetNeedsReviewFilter(false))">全部</MButton>
                    <MButton Color="Primary" Outlined="@(!_onlyNeedsReview)" OnClick="@(() => SetNeedsReviewFilter(true))">仅待复核</MButton>
                </MButtonGroup>
                <div class="flex-grow-1"></div>
                @if (_dirtyRowIds.Count > 0)
                {
                    <span class="text-caption warning--text d-flex align-center" Role="status">
                        @_dirtyRowIds.Count 处修改未保存 · Enter 保存
                        <MButton XSmall Variant="Text" OnClick="DiscardAllEdits">放弃全部</MButton>
                    </span>
                }
                <MButton aria-expanded="@(_showAdd ? "true" : "false")" OnClick="@(() => _showAdd = !_showAdd)">
                    <MIcon Small Class="mr-1">mdi-plus</MIcon>
                    新增词条
                </MButton>
            </div>

            @if (_showAdd)
            {
                <MDivider />
                <form @onsubmit="AddNewEntryAsync" class="pa-4">
                    <div class="mb-4">
                        <h2 class="text-h6 mb-1">新增或更新词条</h2>
                        <span class="text-caption">同一命名空间下 Key 相同则更新；占位符写作 {name}</span>
                    </div>
                    @* MRow/MCol 12 格网格：命名空间/Key/源文案/上下文四列一行（lg），最大长度窄列收尾；
                       命名空间的 hint 合并到 Label（原 PersistentHint 撑行高导致参差不齐） *@
                    <MRow>
                        <MCol Cols="12" Sm="6" Lg="3">
                            @* 命名空间：可自由输入，已有命名空间作候选（原 datalist 的语义） *@
                            <MCombobox TItem="string" TItemValue="string" TValue="string"
                                       Items="@(CurrentNamespaces.Where(n => !string.IsNullOrEmpty(n.Code)).Select(n => n.Code).ToList())"
                                       ItemText="n => n" ItemValue="n => n"
                                       @bind-Value="_newNs" Dense Outlined HideDetails="true"
                                       Label="命名空间（留空 = 项目根）" Placeholder="如 order" />
                        </MCol>
                        <MCol Cols="12" Sm="6" Lg="2">
                            <MTextField TValue="string" @bind-Value="_newKey" Dense Outlined HideDetails="true"
                                        Label="词条 Key" Placeholder="如 confirmPay" />
                        </MCol>
                        <MCol Cols="12" Sm="6" Lg="3">
                            <MTextField TValue="string" @bind-Value="_newSourceText" Dense Outlined HideDetails="true"
                                        Label="源语言文案" Placeholder="如 确认支付 {amount} 元" />
                        </MCol>
                        <MCol Cols="12" Sm="6" Lg="2">
                            <MTextField TValue="string" @bind-Value="_newContext" Dense Outlined HideDetails="true"
                                        Label="上下文说明" Placeholder="如 收银台底部主按钮" />
                        </MCol>
                        <MCol Cols="12" Sm="6" Lg="2">
                            <MTextField TValue="int?" @bind-Value="_newMaxLength" Type="number" min="1" Dense Outlined HideDetails="true"
                                        Label="最大长度" Placeholder="如 25" />
                        </MCol>
                    </MRow>
                    <div class="d-flex justify-end mt-4" style="gap:0.5rem">
                        <MButton OnClick="@(() => _showAdd = false)">收起</MButton>
                        <MButton Color="Primary" Type="submit">保存词条</MButton>
                    </div>
                </form>
                <MDivider />
            }

            @if (rows.Count == 0)
            {
                <div class="pa-4">
                    <MAlert Type="@AlertTypes.Info" Text Dense Class="mb-0">
                        @(string.IsNullOrWhiteSpace(_searchKeyword) && string.IsNullOrEmpty(_selectedNamespaceCode)
                            ? "还没有词条。"
                            : "没有符合当前筛选的词条。")
                    </MAlert>
                </div>
            }
            else
            {
                @* 矩阵保留语义 <table>：EntryRow 的键击级编辑优化依赖原生 input + @key 版本复位（见 EntryRow 顶注）。
                   .lingua-matrix 与 .ai-col 的少量结构样式（AI 列粘性、单元格输入形态）在残留 CSS 白名单里定义。 *@
                <MSimpleTable Dense Class="lingua-matrix" Role="tabpanel">
                        <thead>
                            <tr>
                                <th>词条</th>
                                @for (var i = 0; i < ActiveCultures.Count; i++)
                                {
                                    var culture = ActiveCultures[i];
                                    @* 默认语种（源文案语种）永远排第一列：它是其余译文的参照，放在中间会被滚动挤出去 *@
                                    <th lang="@culture">@UiText.Locale(culture) <code>@culture</code>
                                        @if (i == 0 && IsSourceCulture(culture))
                                        {
                                            <MChip XSmall Class="ml-1">源</MChip>
                                        }
                                    </th>
                                }
                                <th class="act ai-col">AI 翻译</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in pageRows)
                            {
                                @* 每行一个组件：只有这一行用到的输入变了才重渲染（见 EntryRow），页面其他状态变化不再重建上百行 *@
                                <EntryRow @key="entry.Id"
                                          Entry="entry"
                                          Cultures="ActiveCultures"
                                          TargetCultures="TargetCultures"
                                          DefaultCulture="@DefaultCultureOrFallback"
                                          Notes="NotesFor(entry)"
                                          IsSharedScope="IsSharedScope"
                                          Impact="SharedImpactOf(entry)"
                                          Busy="_isBusy"
                                          Ai="AiStateOf(entry)"
                                          AnyAiBusy="_aiBusy is not null"
                                          DiscardToken="@_discardToken"
                                          OnPendingChanged="@(hasPending => OnRowPendingChanged(entry, hasPending))"
                                          OnContextEdited="@(value => OnContextEditedAsync(entry, value))"
                                          OnTranslationEdited="@(edit => OnTranslationEditedAsync(entry, edit.Culture, edit.Value))"
                                          OnRequestAi="@(overwrite => RequestAiTranslateAsync(entry, overwrite))"
                                          OnRequestDelete="@(() => RequestDeleteEntry(entry))" />
                            }
                        </tbody>
                    </MSimpleTable>
                <MDivider />
                <div class="d-flex align-center flex-wrap pa-4" style="gap:0.75rem">
                    <span class="text-caption">共 <b>@rows.Count</b> 条</span>
                    <MSelect TItem="int" TItemValue="int" TValue="int"
                             Items="PageSizeOptions"
                             ItemText='@(s => $"每页 {s} 条")' ItemValue="s => s"
                             @bind-Value="_pageSize" @bind-Value:after="ResetPage"
                             Dense Outlined HideDetails="true" Style="max-width:132px" aria-label="每页条数" />
                    <div class="flex-grow-1"></div>
                    <MPagination Value="@(pageIndex + 1)" ValueChanged="OnMatrixPageChanged"
                                 Length="@totalPages" TotalVisible="5" Circle="true" />
                </div>
            }
        }
        else
        {
            <div class="pa-4">
                <span class="text-caption">
                    @(_validationIssues.Count == 0
                        ? "当前范围内没有发现问题。"
                        : $"共 {_validationIssues.Count} 项，来自当前筛选范围内的 {rows.Count} 条词条。")
                </span>
            </div>

            @if (_validationIssues.Count == 0)
            {
                <div class="px-4 pb-4">
                    <MAlert Type="@AlertTypes.Success" Text Dense Class="mb-0">规则与术语库检查全部通过。</MAlert>
                </div>
            }
            else
            {
                <MSimpleTable Dense Role="tabpanel">
                    <thead>
                        <tr>
                            <th>词条</th>
                            <th>语种</th>
                            <th>问题</th>
                            <th>级别</th>
                            <th>建议值</th>
                            <th class="text-right"><span class="sr-only">操作</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var issue in reportRows)
                        {
                            <tr>
                                <td><code>@issue.EntryKey</code></td>
                                <td><code>@issue.Culture</code></td>
                                <td>
                                    <strong class="text-body-2">@UiText.Rule(issue.RuleCode)</strong>
                                    <span class="d-block text-caption">@issue.Message</span>
                                </td>
                                <td class="text-nowrap">
                                    <MChip XSmall Color="@(issue.Severity == IssueSeverity.Error ? "Error" : "Warning")">@SeverityLabel(issue.Severity)</MChip>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(issue.SuggestedFix))
                                    {
                                        <span class="text-caption">—</span>
                                    }
                                    else
                                    {
                                        @issue.SuggestedFix
                                    }
                                </td>
                                <td class="text-right text-nowrap">
                                    <MButton XSmall Variant="Text" OnClick="@(() => LocateIssue(issue))">在矩阵中定位</MButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MSimpleTable>
                <MDivider />
                <div class="d-flex align-center flex-wrap pa-4" style="gap:0.75rem">
                    <span class="text-caption">共 <b>@_validationIssues.Count</b> 项</span>
                    <div class="flex-grow-1"></div>
                    <MPagination Value="@(reportPageIndex + 1)" ValueChanged="OnReportPageChanged"
                                 Length="@reportTotalPages" TotalVisible="5" Circle="true" />
                </div>
            }
        }
        </MCard>
    </section>
}

<ConfirmDialog Open="@(_pendingOverwrite is not null)"
               Title="覆盖已审核的译文？"
               Message="@OverwriteConfirmMessage"
               ConfirmText="覆盖并重新翻译"
               Danger="true"
               OnConfirm="ConfirmOverwriteAsync"
               OnCancel="CancelOverwrite" />

<ConfirmDialog Open="@(_pendingDelete is not null)"
               Title="删除词条？"
               Message="@DeleteConfirmMessage"
               ConfirmText="删除词条"
               Danger="true"
               OnConfirm="ConfirmDeleteEntryAsync"
               OnCancel="() => _pendingDelete = null" />

@* 项目级配置抽屉：放在页面末尾，与正文列表互不影响（打开时不改变矩阵布局，关闭后不留空档） *@
<SlideOver Open="@_cultureDrawer" Title="项目语种" Intro="@CultureDrawerIntro" OnClose="CloseCultureDrawer">
    <ChildContent>
        @if (CurrentProject is { } cultureProject)
        {
            <div class="d-flex flex-column" style="gap:1.25rem">
                <div>
                    <div class="text-body-2 mb-1">
                        支持的语种
                        <span class="text-caption">点击 × 移除；默认语种不可移除，需先把默认语种改为其他语种。改动立即保存。</span>
                    </div>
                    <div class="d-flex flex-wrap" style="gap:0.5rem">
                        @foreach (var culture in cultureProject.SupportedCultures)
                        {
                            var isDefault = string.Equals(culture, cultureProject.DefaultCulture, StringComparison.OrdinalIgnoreCase);
                            <MChip Label Color="@(isDefault ? "Primary" : "Default")"
                                   Close="@(isDefault ? false : true)" Disabled="@_cultureBusy"
                                   OnCloseClick="@(() => RequestRemoveCulture(culture))"
                                   aria-label="@($"移除 {culture}")">
                                <strong lang="@culture">@UiText.Locale(culture)</strong>
                                <code class="ml-1">@culture</code>
                                @if (isDefault)
                                {
                                    <span class="ml-1">默认</span>
                                }
                            </MChip>
                        }
                    </div>
                </div>

                <div>
                    <div class="text-body-2 mb-1">
                        新增语种
                        <span class="text-caption">输入中文名、英文名或代码都能搜索（如 韩语 / Korean / ko）；选中即添加，不需要再点保存</span>
                    </div>
                    @* 排除已支持的语种：搜不到重复项，也不会因为手写拼错多出一个空语种。
                       ExtraCodes 补上默认语种（字段缓存，见 _addCultureExtraCodes 的说明）：ICU 枚举不到 zh-CN
                       （它规范成 zh-Hans-CN），但它是本平台的源文案语种，一旦项目把它移除，不补这一项就再也选不回来。
                       ClearAfterSelect：选完清空搜索框，方便连着加下一个。 *@
                    <CultureSelect @key="@($"add-culture-{cultureProject.SupportedCultures.Count}")"
                                   Value="@null" Placeholder="搜索语种，如 韩语 / Korean / ko"
                                   ClearAfterSelect="true"
                                   ExtraCodes="@_addCultureExtraCodes"
                                   ExcludeCodes="@(cultureProject.SupportedCultures)"
                                   ValueChanged="AddCultureAsync" AriaLabel="新增语种" />
                </div>

                <div>
                    <div class="text-body-2 mb-1">
                        默认语种
                        <span class="text-caption">源文案语种，也是译文缺失时的回退语种；改它会改变「源语言」列的语义</span>
                    </div>
                    @* 受控组件：用户选了别的语种但取消确认时，显示值跟随参数回到实际值，原 @key 复位技巧不再需要 *@
                    <MSelect TItem="string" TItemValue="string" TValue="string"
                             Items="@(cultureProject.SupportedCultures.ToList())"
                             ItemText="@(c => $"{c} · {UiText.Locale(c)}")" ItemValue="c => c"
                             Value="@cultureProject.DefaultCulture" ValueChanged="OnDefaultCultureSelect"
                             Dense Outlined Disabled="@_cultureBusy" aria-label="默认语种" />
                </div>

                @if (_cultureBusy)
                {
                    <p class="text-caption mb-0" Role="status">正在保存语种配置…</p>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        <span class="text-caption">新增语种后词条初始为「缺失」，可用「AI 批量补全」生成译文；重新发布后语种才会进入各端 manifest。移除语种不会删除已有译文，重新添加即可恢复。</span>
        <MButton OnClick="CloseCultureDrawer">收起</MButton>
    </FooterContent>
</SlideOver>

<SlideOver Open="@_writeKeyDrawer" Title="接入密钥"
           Intro="项目写密钥用于缺词上报鉴权（X-Lingua-Key 请求头）。仅服务端 SDK 携带；MAUI / Vue 客户端不支持上报，密钥不要下发到终端。"
           OnClose="CloseWriteKeyDrawer">
    <ChildContent>
        @if (CurrentProject is { } keyProject)
        {
            <div>
                <div class="text-body-2 mb-1">当前密钥</div>
                <div class="d-flex" style="gap:0.5rem">
                    <MTextField TValue="string"
                                Value="@(_revealWriteKey ? keyProject.WriteKey : "••••••••••••••••••••••••")"
                                Readonly="true" Dense Outlined HideDetails="true" Class="flex-grow-1" aria-label="当前密钥" />
                    <MButton OnClick="RevealWriteKey">@(_revealWriteKey ? "隐藏" : "显示")</MButton>
                    <MButton OnClick="CopyWriteKey" Disabled="@(_revealWriteKey is false || keyProject.WriteKey is null)">复制</MButton>
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <span class="text-caption">业务项目配置 <code>Lingua:WriteKey</code> 填这里复制的密钥；重置后旧密钥立即失效，需同步更新业务配置。</span>
        <MButton Color="Error" OnClick="RegenerateWriteKeyAsync" Disabled="@_isBusy">重置密钥</MButton>
    </FooterContent>
</SlideOver>

<ConfirmDialog Open="@(_pendingCultureRemove is not null)"
               Title="移除这个语种？"
               Message="@CultureRemoveMessage"
               ConfirmText="移除语种"
               Danger="true"
               OnConfirm="ConfirmRemoveCultureAsync"
               OnCancel="() => _pendingCultureRemove = null" />

<ConfirmDialog Open="@(_pendingDefaultCulture is not null)"
               Title="更改默认语种？"
               Message="@DefaultCultureConfirmMessage"
               ConfirmText="更改默认语种"
               OnConfirm="ConfirmChangeDefaultCultureAsync"
               OnCancel="() => _pendingDefaultCulture = null" />

@code {
    // ---- 命名空间下拉的选项（原生 option 的 Label/Value 拆成记录，喂给 MSelect） ----
    private sealed record NsOption(string Value, string Label);

    private List<NsOption> NamespaceOptions
    {
        get
        {
            var list = new List<NsOption> { new("", "全部命名空间"), new("__root__", "（项目根）") };
            list.AddRange(CurrentNamespaces.Where(n => !string.IsNullOrEmpty(n.Code))
                .Select(n => new NsOption(n.Code, n.Code + (n.IsShared ? " · 共享" : ""))));
            return list;
        }
    }

    // ---- 图例 / 堆叠条的段颜色：数据状态 → 皮肤 token 色 ----
    private static string LegendColor(string css) => css switch
    {
        "approved" => "Success",
        "ai" => "Info",
        "review" => "Warning",
        _ => "Grey"
    };

    // ---- MTabs / MPagination 的值形状适配（StringNumber / 1 基页码） ----
    private StringNumber? ViewTabValue => (int)_view;

    private Task OnViewTabChanged(StringNumber? value)
    {
        _view = (MatrixView)(value?.ToInt32() ?? (int)MatrixView.Entries);
        return Task.CompletedTask;
    }

    private void OnMatrixPageChanged(int page) => GoToPage(page - 1);

    private void OnReportPageChanged(int page) => GoToReportPage(page - 1);

    // ---- 默认语种下拉：MSelect 的 ValueChanged(string) 桥接到页面的 ChangeEventArgs 处理器 ----
    private void OnDefaultCultureSelect(string? value) => OnDefaultCultureChanged(new ChangeEventArgs { Value = value });

    // 堆叠条分段的数据驱动宽度
    private static string Flex(int n) => $"flex:{n}";
}
