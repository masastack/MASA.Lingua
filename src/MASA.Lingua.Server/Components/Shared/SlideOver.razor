@* 右侧抽屉：承载「语种设置」「接入密钥」「发布策略」这类低频项目配置。
   放在页头按钮里打开，而不是在页面正文里原地展开：正文里的设置面板会把主内容推下去。

   Masa.Blazor 的 fixed 定位类条件是 !Absolute && (App || Fixed)：Temporary 不会自动进入 fixed
   （与 Vuetify2 不同），这里必须显式 Fixed，否则抽屉是文档流里的静态块而不是右侧浮层。
   Fixed + Temporary 自带遮罩、Esc 关闭与焦点管理；组件自关时通过 OnClose 通知页面回写 Open。

   三段式布局（头部固定 / 正文滚动 / footer 贴底）由 .lingua-drawer* 三个类承担：
   MNavigationDrawer 内部有 __content 滚动容器包裹 slot 内容，直接在子元素上写 flex-grow 不生效
   （父是块级不是 flex），必须用一整屏高的 flex column 包装。 *@
<MNavigationDrawer @bind-Value="_open" @bind-Value:after="OnInternalChanged" Right Temporary Fixed Width="480">
    <div class="lingua-drawer">
        <div class="d-flex align-center justify-space-between px-4 pt-4 lingua-drawer-head">
            <div class="lingua-drawer-title">
                <h2 class="text-h6 mb-1">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Intro))
                {
                    <p class="text-body-2 text--secondary mb-0">@Intro</p>
                }
            </div>
            <MButton Icon OnClick="CloseAsync" aria-label="关闭">
                <MIcon>mdi-close</MIcon>
            </MButton>
        </div>
        <MDivider Class="my-3 lingua-drawer-head" />

        <div class="px-4 pb-4 flex-grow-1 lingua-drawer-body">
            @ChildContent
        </div>

        @if (FooterContent is not null)
        {
            <MDivider Class="lingua-drawer-foot" />
            <div class="px-4 py-3 lingua-drawer-foot">
                @FooterContent
            </div>
        }
    </div>
</MNavigationDrawer>

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public string Title { get; set; } = "";

    /// <summary>标题下的说明文字（一句话解释这个面板在改什么、什么时候生效）。</summary>
    [Parameter] public string? Intro { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? FooterContent { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private bool? _open;
    private bool _pushed;

    protected override void OnParametersSet()
    {
        // 页面改了 Open → 同步给抽屉；_pushed 用来区分「外部改的」和「组件自关的」
        if (Open != _pushed)
        {
            _open = Open;
            _pushed = Open;
        }
    }

    private Task OnInternalChanged()
    {
        // Esc / 遮罩：抽屉自己关闭 → 通知页面（页面随后把 Open 置 false）
        if (_open == false && _pushed)
        {
            return OnClose.InvokeAsync();
        }
        return Task.CompletedTask;
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
