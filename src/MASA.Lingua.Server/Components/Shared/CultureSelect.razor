@* 可搜索的语种选择器：近 900 项的 ICU 目录不能靠原生 select 的「键入前缀跳转」，MAutocomplete 承担
   下拉、键盘（上下/Enter/Esc）与焦点管理；过滤在这里自定义（代码 / 本地名 / 英文名 / 中文名，代码前缀优先），
   且只把命中的前 MaxResults 项喂给组件——避免每次键击在 Blazor Server 电路里渲染近千行列表。 *@
<MAutocomplete TItem="LinguaCultureOption" TItemValue="string" TValue="string"
               Items="VisibleItems"
               ItemText="o => LabelOf(o.Code)"
               ItemValue="o => o.Code"
               NoFilter="true"
               Clearable="true"
               Dense
               Outlined
               HideDetails="true"
               Placeholder="@Placeholder"
               aria-label="@AriaLabel"
               Value="@Value"
               ValueChanged="OnSelected"
               OnSearchInputUpdate="OnSearchInput" />

@code {
    /// <summary>当前语种代码（选中项）。</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>输入框占位文案。</summary>
    [Parameter] public string? Placeholder { get; set; } = "搜索语种，如 韩语 / Korean / ko";

    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// 除 ICU 目录外还必须可选的语种（通常是「本项目已在用的语种」与平台默认源语种）。
    /// 这类代码是真实存在的预定义文化，但 ICU 的枚举结果里未必有（如 zh-CN 被规范成 zh-Hans-CN）。
    /// </summary>
    [Parameter] public IReadOnlyCollection<string>? ExtraCodes { get; set; }

    /// <summary>不列入可选项的语种（例如项目已支持的语种，只允许在「新增」里选没选过的）。</summary>
    [Parameter] public IReadOnlyCollection<string>? ExcludeCodes { get; set; }

    /// <summary>
    /// 选中后是否清空搜索框（「新增语种」场景要清空方便接着加下一个；「切换默认语种」要显示当前值）。
    /// MAutocomplete 是受控组件：页面在新增场景不回填 Value，输入框自然为空；切换场景回填 Value 即显示当前值。
    /// 参数保留以兼容页面调用方。
    /// </summary>
    [Parameter] public bool ClearAfterSelect { get; set; }

    /// <summary>列表最多同时渲染多少项：近 900 项全渲染会让每次键击都重建一张长列表。</summary>
    [Parameter] public int MaxResults { get; set; } = 50;

    private List<LinguaCultureOption> _source = [];
    private List<LinguaCultureOption> _visible = [];
    private IReadOnlyCollection<string>? _renderedExtra;
    private IReadOnlyCollection<string>? _renderedExclude;

    /// <summary>
    /// 喂给 MAutocomplete 的候选集：当前过滤结果；选中项若不在其中（如 ExtraCode 或被过滤掉）补到最前，
    /// 否则组件匹配不到选中项、无法回显选中值。
    /// </summary>
    private List<LinguaCultureOption> VisibleItems
    {
        get
        {
            if (Value is { Length: > 0 }
                && _visible.All(o => !string.Equals(o.Code, Value, StringComparison.OrdinalIgnoreCase)))
            {
                var selected = _source.FirstOrDefault(o => string.Equals(o.Code, Value, StringComparison.OrdinalIgnoreCase))
                    ?? LinguaCultures.WithExtraCodes([Value]).FirstOrDefault();
                if (selected is not null)
                {
                    return [selected, .. _visible];
                }
            }
            return _visible;
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(ExtraCodes, _renderedExtra)
            || !ReferenceEquals(ExcludeCodes, _renderedExclude)
            || _source.Count == 0)
        {
            _renderedExtra = ExtraCodes;
            _renderedExclude = ExcludeCodes;

            var pool = LinguaCultures.WithExtraCodes(ExtraCodes);
            _source = ExcludeCodes is { Count: > 0 }
                ? pool.Where(c => !ExcludeCodes.Contains(c.Code, StringComparer.OrdinalIgnoreCase)).ToList()
                : [.. pool];
            _visible = FilterPool("");
        }
    }

    /// <summary>键入搜索词：只重算候选集，不触发父页面重渲染。</summary>
    private void OnSearchInput(string? query) => _visible = FilterPool(query ?? "");

    private Task OnSelected(string? value) => ValueChanged.InvokeAsync(value ?? "");

    /// <summary>
    /// 过滤：代码前缀优先，其次「代码 / 本地名 / 英文名 / 中文名」包含。
    /// 只保留前 <see cref="MaxResults"/> 项——用户继续输入就能收窄，不必把 900 项全渲出来。
    /// 空搜索词：目录最前面的一段（按代码排序，等于「从头看」）。
    /// </summary>
    private List<LinguaCultureOption> FilterPool(string query)
    {
        query = query.Trim();

        if (query.Length == 0)
        {
            return _source.Take(MaxResults).ToList();
        }

        var prefix = _source
            .Where(o => o.Code.StartsWith(query, StringComparison.OrdinalIgnoreCase))
            .OrderBy(o => o.Code.Length)
            .ThenBy(o => o.Code, StringComparer.Ordinal);

        var contains = _source
            .Where(o => !o.Code.StartsWith(query, StringComparison.OrdinalIgnoreCase))
            .Where(o =>
                o.Code.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                o.NativeName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                o.EnglishName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                o.ChineseName.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderBy(o => o.Code, StringComparer.Ordinal);

        return prefix.Concat(contains).Take(MaxResults).ToList();
    }

    private static string LabelOf(string code) => $"{code} · {LinguaCultures.GetName(code)}";
}
