@* 防抖搜索框：MTextField 的 DebounceInterval 在 JS 侧防抖——键击不产生 Blazor 电路消息、
   不触发父页面重渲染，停顿 DebounceMs 后才通过 ValueChanged 通知父页面。
   若把 @oninput 直接写在父页面上，Blazor 会在事件处理开始和结束各重渲染一次整页，防抖也挡不住。 *@
<MTextField TValue="string"
             Value="@Value"
             ValueChanged="ValueChanged"
             ValueExpression="() => Value"
             DebounceInterval="@DebounceMs"
             Immediate="false"
             PrependInnerIcon="mdi-magnify"
             Clearable="true"
             Dense
             Outlined
             HideDetails="true"
             Placeholder="@Placeholder"
             aria-label="@AriaLabel"
             Class="@Class" />

@code {
    /// <summary>
    /// 防抖搜索框：键击只留在本组件（MTextField 的 JS 侧计时），停顿 <see cref="DebounceMs"/> 后才通知父页面。
    /// 父页面（词条矩阵一页上百行的大表）不会在每个键击上重渲染。
    /// </summary>
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Class { get; set; } = "input search";
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int DebounceMs { get; set; } = 250;
}
