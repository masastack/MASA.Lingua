@* 站内确认弹窗：Esc / 遮罩点击等同取消（MDialog 默认行为），焦点管理与 aria 由组件内置。
   页面用 bool Open 控制开关；组件自关（Esc/遮罩）时通过 OnCancel 通知页面回写状态。

   按钮顺序按「取消在前、确认在后」：确认是实心（危险操作给 Error，普通操作给 Primary），
   取消是文本按钮——一眼能看出哪个是主操作、哪个是退路。 *@
<MDialog @bind-Value="_open" @bind-Value:after="OnInternalChanged" MaxWidth="440">
    <ChildContent>
        <MCard>
            <MCardTitle Class="text-h6">@Title</MCardTitle>
            <MCardText Class="text-body-2">@Message</MCardText>
            <MCardActions>
                <MSpacer />
                <MButton Variant="Text" OnClick="CancelAsync">@CancelText</MButton>
                <MButton Color="@(Danger ? "Error" : "Primary")" Class="ml-2" OnClick="ConfirmAsync">@ConfirmText</MButton>
            </MCardActions>
        </MCard>
    </ChildContent>
</MDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "确认操作";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ConfirmText { get; set; } = "确定";
    [Parameter] public string CancelText { get; set; } = "取消";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool _open;
    private bool _pushed;

    protected override void OnParametersSet()
    {
        // 页面改了 Open → 同步给 MDialog；_pushed 用来区分「外部改的」和「组件自关的」
        if (Open != _pushed)
        {
            _open = Open;
            _pushed = Open;
        }
    }

    private Task OnInternalChanged()
    {
        // Esc / 遮罩：组件自己关闭 → 走取消分支（页面随后把 Open 置 false，两边状态重新一致）
        if (_open == false && _pushed)
        {
            return OnCancel.InvokeAsync();
        }
        return Task.CompletedTask;
    }

    private Task ConfirmAsync() => OnConfirm.InvokeAsync();

    private Task CancelAsync() => OnCancel.InvokeAsync();
}
