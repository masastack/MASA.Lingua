<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>MASA.Lingua Server: Blazor Server Admin UI, Static {culture}.json Publisher, ETag/304 Distribution API, and SSE Broadcaster.</Description>
    <UserSecretsId>6c56c277-d64d-430e-8ba2-937204242ee2</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>
  <ItemGroup>
    <!-- 管理后台 SSO：OIDC 处理器不在共享框架里，必须显式引包 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <!-- SSO 域名统一由 DCC（MasaStackConfig）解析；与 masa.specdoc 同版本，避免行为漂移 -->
    <PackageReference Include="Masa.Contrib.StackSdks.Config" Version="1.2.1-preview.93" />
    <!-- 顶栏项目切换器的数据源：MASA Stack PM（项目管理）服务客户端，版本与 Config 严格对齐 -->
    <PackageReference Include="Masa.Contrib.StackSdks.Pm" Version="1.2.1-preview.93" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- 管理后台 UI 组件库。版本须与所用皮肤包的 masa-skin.json masaVersion 对齐；
         换肤只替换皮肤包与 <link>，应用层代码不依赖任何皮肤类型或主题名。 -->
    <PackageReference Include="Masa.Blazor" Version="[1.12.0-alpha.2]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MASA.Lingua.Core\MASA.Lingua.Core.csproj" />
    <ProjectReference Include="..\Storage\MASA.Lingua.Storage.EfCore\MASA.Lingua.Storage.EfCore.csproj" />
    <ProjectReference Include="..\MASA.Lingua.AI\MASA.Lingua.AI.csproj" />
    <ProjectReference Include="..\Storage\MASA.Lingua.Storage.Migrations.PostgreSql\MASA.Lingua.Storage.Migrations.PostgreSql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 词条矩阵的渲染口径（EntryMatrix）是 internal：只给页面用，但它的正确性必须被测试钉住 -->
    <InternalsVisibleTo Include="MASA.Lingua.Tests" />
  </ItemGroup>
</Project>
