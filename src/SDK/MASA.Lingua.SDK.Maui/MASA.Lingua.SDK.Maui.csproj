<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 双目标：.NET 8 与 .NET 10 客户端应用均可引用；依旧不依赖 MAUI workload。 -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>MASA.Lingua client for .NET MAUI (and any other .NET 8/10 client app): local cache, manifest/ETag sync, bindable indexer and IStringLocalizer. Has no dependency on the MAUI workload.</Description>
  </PropertyGroup>

  <!-- 条件引用只改版本、不改包名集合 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MASA.Lingua.SDK.Abstractions\MASA.Lingua.SDK.Abstractions.csproj" />
  </ItemGroup>
</Project>
