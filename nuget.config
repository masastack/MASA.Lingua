<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 皮肤包（MasaDesign.Blazor / Masa.ThemeContract）由 masa-blazor-theme-adaptation 仓库打包，尚未发布到 nuget.org；
       nupkg 随本仓库提交在 local-feed/，CI 与新克隆无需检出另一个仓库即可还原。
       重新打包：dotnet pack E:\masa-blazor-theme-adaptation\masa-design\src\MasaDesign.Blazor\MasaDesign.Blazor.csproj -c Release -o local-feed
               dotnet pack E:\masa-blazor-theme-adaptation\src\Masa.ThemeContract\Masa.ThemeContract.csproj -c Release -o local-feed -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="lingua-local-feed" value="local-feed" />
  </packageSources>
</configuration>
